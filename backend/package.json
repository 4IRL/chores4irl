{
  "name": "backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../scripts/dev-backend.mjs",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "npm run types && vitest run",
    "test:watch": "vitest",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "migrate:remote": "wrangler d1 migrations apply DB --remote",
    "bootstrap-admin": "tsx scripts/bootstrap-admin.ts",
    "seed-mock-chores": "tsx scripts/seed-mock-chores.ts",
    "dev-jwt": "tsx scripts/dev-jwt.ts"
  },
  "dependencies": {
    "hono": "4.12.27",
    "jose": "6.2.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.18.0",
    "tsx": "4.22.5",
    "typescript": "6.0.3",
    "vitest": "4.1.9",
    "wrangler": "4.107.0"
  }
}
